# Copy to .env if you prefer environment configuration over the Settings UI.
# The server loads .env automatically at startup. Everything is optional:
# with no keys, the harness runs in offline demo mode.

# demo | openai | anthropic | auto
HARNESS_PROVIDER=auto

# Any OpenAI-compatible endpoint (OpenAI, DeepSeek, OpenRouter, LM Studio, Ollama /v1)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Convenience preset: if DEEPSEEK_API_KEY is set, auto mode uses DeepSeek.
DEEPSEEK_API_KEY=

# Anthropic (native Messages API; enables extended thinking and prompt caching)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=4400
# Optional: keep runtime data somewhere other than ./data
# HARNESS_DATA_DIR=data-local
